{
  "mcpServers": {
    "default-server": {
      "command": "node",
      "args": ["packages/server/dist/index.js", "--transport", "stdio", "--tools", "tools"],
      "env": {
        "NODE_OPTIONS": "--no-deprecation",
        "DB2i_HOST": "<DB2i_HOST>",
        "DB2i_USER": "<DB2i_USER>",
        "DB2i_PASS": "<DB2i_PASS>",
        "DB2i_PORT": "<DB2i_PORT>"
      }
    }
  }
}

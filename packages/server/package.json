{
  "name": "@ibm/ibmi-mcp-server",
  "version": "0.6.2",
  "description": "A production-grade MCP server for IBM i",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "ibmi-mcp-server": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/public/tools.d.ts",
      "import": "./dist/public/tools.js"
    },
    "./services": {
      "types": "./dist/public/services.d.ts",
      "import": "./dist/public/services.js"
    },
    "./context": {
      "types": "./dist/public/context.d.ts",
      "import": "./dist/public/context.js"
    },
    "./formatting": {
      "types": "./dist/public/formatting.d.ts",
      "import": "./dist/public/formatting.js"
    }
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IBM/ibmi-mcp-server.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/IBM/ibmi-mcp-server/issues"
  },
  "homepage": "https://github.com/IBM/ibmi-mcp-server#readme",
  "scripts": {
    "build": "tsc && tsc-alias",
    "postbuild": "node ../../scripts/make-executable.mjs dist/index.js",
    "start": "node dist/index.js",
    "start:stdio": "MCP_LOG_LEVEL=debug MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_LOG_LEVEL=debug MCP_TRANSPORT_TYPE=http node dist/index.js",
    "list-toolsets": "node dist/index.js --list-toolsets --tools ../../tools",
    "rebuild": "tsx scripts/clean.ts && npm run build",
    "depcheck": "npx depcheck",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,js,json,html,css}\"",
    "inspector": "npx @modelcontextprotocol/inspector --config mcp.json --server default-server",
    "mcpjam": "npx @mcpjam/cli",
    "pack:full": "rm -rf release && npm ci && npm run build && mkdir -p release/app && cp -R dist package.json package-lock.json node_modules release/app && tar -C release -czf release/ibmi-mcp-server-${npm_package_version}-full.tgz app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-schemas": "tsx scripts/generate-json-schemas.ts",
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix --production",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy:debug": "./scripts/debug-deploy.sh",
    "deploy:debug:fast": "./scripts/debug-deploy.sh --skip-validation --skip-build",
    "deploy:debug:safe": "./scripts/debug-deploy.sh --skip-modules"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@ibm/mapepire-js": "^0.6.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "dotenv": "^16.6.1",
    "glob": "^10.5.0",
    "hono": "^4.8.9",
    "jose": "^6.0.13",
    "js-yaml": "^4.1.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "typescript",
    "mcp",
    "model-context-protocol",
    "llm",
    "ai-integration",
    "mcp-server",
    "hono",
    "stdio",
    "http",
    "authentication",
    "oauth",
    "zod",
    "opentelemetry",
    "observability",
    "tracing",
    "metrics"
  ],
  "author": "ajshedivy <adam.shedivy@ibm.com> (https://github.com/ajshedivy/ibmi-mcp-server#readme)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
